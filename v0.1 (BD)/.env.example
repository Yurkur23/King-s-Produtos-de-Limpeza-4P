# Configuração LOCAL de desenvolvimento. Nunca publique seu .env.
DATABASE_URL=postgresql://kings:kings_dev_password@localhost:5432/kings
API_PORT=3001
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Habilita usuários e catálogo fictícios. Use somente em testes acadêmicos.
SEED_DEMO=true
# mock = simulação explícita; disabled = bloqueia novas compras online.
PAYMENT_MODE=mock

# Docker Compose: DATABASE_URL do app é montada internamente.
POSTGRES_DB=kings
POSTGRES_USER=kings
POSTGRES_PASSWORD=kings_dev_password
POSTGRES_PORT=5432
APP_PORT=8080
DOCKER_APP_ORIGIN=http://localhost:8080
