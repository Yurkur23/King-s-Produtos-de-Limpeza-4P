{
  "name": "kings-produtos-limpeza",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env server/seed.mjs",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "format": "oxfmt",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
